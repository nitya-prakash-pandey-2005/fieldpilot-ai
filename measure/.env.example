# Copy to .env and adjust. Every AppConfig field is settable this way using
# MEASURECV__SECTION__FIELD (double underscore separates nesting levels).

MEASURECV_CONFIG=configs/default.yaml

# Authentication -- SET THIS before exposing the service publicly.
MEASURECV__API__API_KEYS=["change-me"]

MEASURECV__API__PORT=8000
MEASURECV__LOG_LEVEL=INFO
MEASURECV__LOG_JSON=true

MEASURECV__RUNTIME__DEVICE=auto
MEASURECV__RUNTIME__PRECISION=auto

# Point at a calibration profile to escape the ~15% uncalibrated scale error.
MEASURECV__CALIBRATION__PROFILE=calibration/camera.json

# Weight cache locations (mount these as volumes in production).
HF_HOME=./models/huggingface
TORCH_HOME=./models/torch

GRAFANA_PASSWORD=admin
