# FieldPilot AI — configuration template.
#
#   cp .env.example .env      (then fill in the real values)
#
# .env itself is gitignored and MUST stay that way — it holds live API keys.
# This file is the committed documentation of what those keys are, with no
# secret values in it. If you ever paste a real key here, it goes to GitHub.

# ─── Environment ────────────────────────────────────────────────────────────
# development | staging | production
# Anything other than development makes the API refuse to boot on a default
# JWT_SECRET instead of coming up quietly insecure.
FIELDPILOT_ENV=development
DEMO_MODE=false

# ─── Auth ───────────────────────────────────────────────────────────────────
# Required outside development. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ─── LLM / VLM / voice ──────────────────────────────────────────────────────
# groq | gemini | vllm | mock
LLM_BACKEND=groq
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_VLM_MODEL=gemini-flash-latest
# Only when self-hosting (LLM_BACKEND=vllm), e.g. after training job T4:
LLM_BASE_URL=http://localhost:8000/v1

# ─── Datastores ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fieldpilot:fieldpilot_password@localhost:5432/fieldpilot
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=askthewall_dev
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379
# qdrant | mock
RETRIEVAL_BACKEND=qdrant

# ─── Agent 1: vision ────────────────────────────────────────────────────────
# After training job T1, point all three at the single FieldPilot-28 model:
#   models/weights/fieldpilot28_v1.pt
YOLO_MODEL_PATH=yolo11n.pt
PPE_MODEL_PATH=api/weights/best.pt
EQUIPMENT_MODEL_PATH=models/weights/forklift_yolov8n.pt

# Scene reasoning / open-vocabulary object identification.
#   gemini  cloud API, needs GEMINI_API_KEY, no local weights   (default)
#   gemma   local Gemma 4, no network, no key, Apache-2.0
# YOLO still supplies the boxes either way — this names what the boxes contain,
# including assets YOLO has no class for (rebar cage, formwork, cable tray).
VLM_BACKEND=gemini

# Only read when VLM_BACKEND=gemma.
#
#   transformers  the HF path. Needs transformers>=5.0 AND a >=16GB GPU: the
#                 model is published as one 16GB shard, so even 4bit downloads
#                 all of it and streams it through host RAM to quantize.
#   llama_cpp     the same model as GGUF (4.59GB + 0.56GB projector), served by
#                 llama-server. This is the one that runs on a 6GB laptop GPU.
#                 Start it with: python scripts/serve_gemma_gguf.py
GEMMA_RUNTIME=transformers
GEMMA_MODEL_ID=google/gemma-4-E4B-it
GEMMA_MAX_NEW_TOKENS=512

# --- GEMMA_RUNTIME=transformers only ---
# 4bit | 8bit | none    (4bit needs bitsandbytes)
GEMMA_QUANTIZATION=4bit
GEMMA_DEVICE_MAP=auto

# --- GEMMA_RUNTIME=llama_cpp only ---
# Any OpenAI-compatible server holding a VISION-capable Gemma 4 works here —
# llama-server (port 8080, via scripts/serve_gemma_gguf.py) or Ollama
# (port 11434, use http://localhost:11434/v1).
#
# MOST GEMMA 4 BUILDS CANNOT SEE. Verify before wiring one up — `ollama show
# <model>` must list a `vision` capability and a Projector section. Of the E4B
# tags, only `gemma4:e4b-it-qat` (6.15GB) carries a projector layer; plain
# `e4b`, `e4b-it-q4_K_M` and `e4b-it-q8_0` are text-only despite the same base
# model being multimodal. A text-only build answers an image request with
# HTTP 400 "model does not support multimodal requests", which this backend
# surfaces verbatim rather than degrading into a text-only guess.
#
# On a 6GB GPU prefer e4b-it-qat over gemma4:12b (7.56GB): the 12B spills ~42%
# to CPU and a single reasoning call can exceed 10 minutes.
GEMMA_LLAMA_CPP_URL=http://127.0.0.1:8080/v1
GEMMA_LLAMA_CPP_TIMEOUT=180
GEMMA_GGUF_DIR=models/weights/gemma4

# ─── Agent 2: measurement ───────────────────────────────────────────────────
# aruco  = marker only, refuse otherwise (most accurate)
# hybrid = ArUco > reference object > monocular depth  (default)
# depth  = force the depth path, for testing it in isolation
DEPTH_BACKEND=hybrid
ARUCO_DICT=DICT_4X4_50
ARUCO_MARKER_MM=100
# Set to 0 on a low-RAM demo laptop; measurement still works via ArUco.
DEPTH_ENABLED=1
DEPTH_MODEL_ID=depth-anything/Depth-Anything-V2-metric-indoor-small-hf
# auto | cuda | cpu
DEPTH_DEVICE=auto
# Overrides the per-device FOV assumption used by the depth path only.
# CAMERA_HFOV_DEG=65
# After training job T2:
# REBAR_MODEL_PATH=models/weights/rebar_lattice_v1.pt

# ─── Agent 9: notifications ─────────────────────────────────────────────────
# Each is optional; an unset channel reports as unconfigured rather than failing.
SLACK_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# ─── Frontend ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:8081
