.env.test.local
.env.production.local
.env.development
.env.production

# Mac/OS
.DS_Store
Thumbs.db

# Project specifics
tree_output.txt
clean_tree.txt

# Runtime state (regenerated locally, not fixture data)
data/offline_queue.db
*.log

# Local databases. api/fieldpilot.db is the SQLite fallback store — it is
# recreated on startup (api/main.py seeds zones, issues and demo users), and it
# accumulates real bcrypt password hashes and whatever issue data a demo run
# produces. Runtime state, not fixture data, and not something to publish.
api/fieldpilot.db
*.sqlite
*.sqlite3

# Embedded Qdrant store, used when no Qdrant container is running. Rebuilt by
# re-running scripts/ingest_spec.py; it holds indexed PDF chunks and their
# embeddings, which are derived data and tens of megabytes of it.
data/qdrant_local/

# Kokoro TTS weights — 310MB and 26MB. GitHub hard-rejects any blob over 100MB,
# so committing the first one does not merely bloat the repo, it makes the push
# fail. Both are downloaded on demand; see the README's Cloud vs Edge section
# for the two curl commands that fetch them.
models/weights/kokoro-v1.0.onnx
models/weights/voices-v1.0.bin

# cloudflared binary, downloaded per-platform to expose the dashboard over HTTPS
# so a phone will grant camera/microphone access. Fetch the build for your OS
# from github.com/cloudflare/cloudflared/releases rather than committing 51MB.
cloudflared-win.exe
tunnel.out
tunnel.err

# Trained weights and datasets are large and regenerable — see
# docs/TRAINING_PLAN.md for how to rebuild them.
data/training/
runs/
