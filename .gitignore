# Local databases. api/fieldpilot.db is the SQLite fallback store — it is
# recreated on startup (api/main.py seeds zones, issues and demo users), and it
# accumulates real bcrypt password hashes and whatever issue data a demo run
# produces. Runtime state, not fixture data, and not something to publish.
api/fieldpilot.db
*.sqlite
*.sqlite3

